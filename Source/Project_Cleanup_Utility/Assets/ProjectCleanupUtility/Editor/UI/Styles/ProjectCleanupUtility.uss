/* Root & Layout */
.root-container {
    flex-grow: 1;
    flex-direction: column;
    padding: 0;
    margin: 0;
}

/* Toolbar / Header */
.toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    min-height: 32px;
    background-color: rgba(40, 40, 40, 0.6);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.toolbar-button {
    margin: 0 2px;
    padding: 4px 12px;
    min-height: 24px;
    border-radius: 3px;
    -unity-font-style: bold;
    font-size: 12px;
}

.toolbar-button:hover {
    background-color: rgba(80, 80, 80, 0.8);
}

.scan-button {
    background-color: rgba(56, 126, 83, 0.8);
    color: rgb(220, 240, 220);
    border-width: 0;
}

.scan-button:hover {
    background-color: rgba(56, 126, 83, 1);
}

.quarantine-button {
    background-color: rgba(180, 140, 40, 0.7);
    color: rgb(255, 250, 220);
    border-width: 0;
}

.quarantine-button:hover {
    background-color: rgba(180, 140, 40, 1);
}

.delete-button {
    background-color: rgba(180, 50, 50, 0.7);
    color: rgb(255, 220, 220);
    border-width: 0;
}

.delete-button:hover {
    background-color: rgba(180, 50, 50, 1);
}

.restore-button {
    background-color: rgba(60, 100, 160, 0.7);
    color: rgb(220, 230, 255);
    border-width: 0;
}

.restore-button:hover {
    background-color: rgba(60, 100, 160, 1);
}

.toolbar-spacer {
    flex-grow: 1;
}

/* Menu Bar Strip (Unity-style top bar) */
.menu-bar {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px;
    min-height: 22px;
    background-color: rgb(60, 60, 60);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.menu-bar-label {
    font-size: 11px;
    color: rgb(180, 180, 180);
    margin-right: 2px;
    padding: 1px 4px;
}

.menu-bar-item {
    margin: 0 1px;
    padding: 1px 8px;
    min-height: 18px;
    border-radius: 2px;
    border-width: 0;
    background-color: transparent;
    color: rgb(190, 190, 190);
    font-size: 11px;
}

.menu-bar-item:hover {
    background-color: rgba(100, 100, 100, 0.6);
    color: rgb(230, 230, 230);
}

.menu-bar-item:active {
    background-color: rgba(80, 80, 80, 0.8);
}

.menu-bar-item:focus {
    border-width: 1px;
    border-color: rgb(100, 180, 255);
}

.menu-bar-separator {
    width: 1px;
    height: 14px;
    background-color: rgba(100, 100, 100, 0.5);
    margin: 0 4px;
}

/* Tab Bar */
.tab-bar {
    flex-direction: row;
    padding: 0 8px;
    background-color: rgba(35, 35, 35, 0.8);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
    min-height: 30px;
    align-items: flex-end;
}

.tab-button {
    padding: 5px 18px;
    margin: 0 1px;
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgba(45, 45, 45, 0.5);
    color: rgb(130, 130, 130);
    font-size: 12px;
    -unity-font-style: bold;
    cursor: link;
}

.tab-button:hover {
    background-color: rgba(60, 60, 60, 0.8);
    color: rgb(180, 180, 180);
}

.tab-button--active {
    background-color: rgba(50, 50, 50, 0.9);
    color: rgb(210, 210, 210);
    border-bottom-width: 2px;
    border-bottom-color: rgb(80, 160, 120);
}

.tab-button--active:hover {
    background-color: rgba(50, 50, 50, 0.9);
    color: rgb(210, 210, 210);
}

.tab-content {
    flex-grow: 1;
    flex-direction: column;
}

/* Statistics Panel */
.stats-panel {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px 12px;
    background-color: rgba(35, 35, 35, 0.8);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
    min-height: 60px;
}

.stat-card {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    margin: 2px 4px;
    border-radius: 4px;
    background-color: rgba(50, 50, 50, 0.6);
    min-width: 120px;
}

.stat-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
}

.stat-value-warning {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(230, 180, 60);
}

.stat-value-danger {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 80, 80);
}

.stat-label {
    font-size: 10px;
    color: rgb(140, 140, 140);
    margin-top: 2px;
}

/* Filter Bar */

.filter-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    min-height: 28px;
    flex-shrink: 0;
    background-color: rgba(38, 38, 38, 0.5);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
}

.search-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    margin: 0 4px;
    min-height: 22px;
}

.filter-dropdown {
    min-width: 200px;
    margin: 0 4px;
    flex-shrink: 0;
}

/* Category Size Breakdown */
.category-breakdown {
    flex-direction: column;
    padding: 8px 12px;
    background-color: rgba(30, 30, 30, 0.5);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
}

.category-breakdown-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(160, 160, 160);
    margin-bottom: 6px;
}

.category-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
}

.category-bar-background {
    flex-grow: 1;
    height: 16px;
    background-color: rgba(50, 50, 50, 0.8);
    border-radius: 2px;
    margin: 0 8px;
    overflow: hidden;
}

.category-bar-fill {
    height: 100%;
    border-radius: 2px;
    background-color: rgba(80, 140, 200, 0.8);
}

.category-name {
    font-size: 11px;
    color: rgb(170, 170, 170);
    min-width: 120px;
}

.category-size {
    font-size: 11px;
    color: rgb(140, 140, 140);
    min-width: 80px;
    -unity-text-align: middle-right;
}

.category-count {
    font-size: 10px;
    color: rgb(120, 120, 120);
    min-width: 50px;
    -unity-text-align: middle-right;
}

/* Asset List */
.asset-list-container {
    flex-grow: 1;
}

.asset-list {
    flex-grow: 1;
}

/* Status Bar */
.status-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    min-height: 24px;
    background-color: rgba(35, 35, 35, 0.8);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}

.status-message {
    font-size: 11px;
    color: rgb(150, 150, 150);
    flex-grow: 1;
}

.status-count {
    font-size: 11px;
    color: rgb(120, 120, 120);
    margin-left: 8px;
}

/* Split Container (Asset List + Side Panel) */
.split-container {
    flex-direction: row;
    flex-grow: 1;
}

/* Dependency Side Panel */
.dependency-side-panel {
    flex-direction: column;
    width: 300px;
    min-width: 220px;
    max-width: 450px;
    background-color: rgba(28, 28, 28, 0.9);
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.4);
    padding: 6px 8px;
}

.dependency-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 80, 0.4);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dep-foldout {
    margin-top: 4px;
    margin-bottom: 2px;
}

.dep-none-label {
    font-size: 11px;
    color: rgb(100, 100, 100);
    -unity-font-style: italic;
    padding-left: 4px;
}

.dependency-item {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    margin: 1px 0;
    border-radius: 2px;
}

.dependency-item:hover {
    background-color: rgba(60, 60, 60, 0.5);
}

.dependency-path {
    font-size: 11px;
    color: rgb(160, 160, 160);
    overflow: hidden;
    text-overflow: ellipsis;
}

.dependency-direction {
    font-size: 10px;
    color: rgb(120, 120, 120);
    margin-right: 4px;
    min-width: 14px;
}

/* Empty State */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-state-text {
    font-size: 14px;
    color: rgb(130, 130, 130);
    -unity-text-align: middle-center;
}

.empty-state-hint {
    font-size: 11px;
    color: rgb(100, 100, 100);
    -unity-text-align: middle-center;
    margin-top: 8px;
}

/* Progress Overlay */
.progress-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 20, 20, 0.85);
}

.progress-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
    margin-bottom: 8px;
}

.progress-bar-container {
    width: 300px;
    height: 6px;
    background-color: rgba(60, 60, 60, 0.8);
    border-radius: 3px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background-color: rgba(80, 160, 120, 0.9);
    border-radius: 3px;
    transition-property: width;
    transition-duration: 200ms;
}

/* Toggle / Checkbox Styles */
.select-all-toggle {
    margin: 0 8px;
}

/* Tooltip Styles */
.tooltip-text {
    font-size: 10px;
    color: rgb(180, 180, 180);
    background-color: rgba(40, 40, 40, 0.95);
    padding: 4px 8px;
    border-radius: 3px;
}

/* Whitelist Panel */
.whitelist-panel {
    flex-direction: column;
    padding: 8px;
    background-color: rgba(30, 30, 30, 0.5);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.2);
}

.whitelist-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(170, 170, 170);
    margin-bottom: 6px;
}

.whitelist-item {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
}

.whitelist-path {
    font-size: 11px;
    color: rgb(150, 150, 150);
    flex-grow: 1;
}

.whitelist-remove-button {
    width: 20px;
    height: 20px;
    font-size: 14px;
    border-width: 0;
    background-color: transparent;
    color: rgb(180, 80, 80);
}

.whitelist-remove-button:hover {
    color: rgb(220, 80, 80);
}

/* Scan Diff Banner (Overview Tab) */
.diff-banner {
    flex-direction: column;
    padding: 8px 12px;
    margin: 6px 8px;
    background-color: rgba(50, 65, 80, 0.6);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgba(80, 160, 200, 0.8);
}

.diff-banner-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(180, 200, 220);
    margin-bottom: 4px;
}

.diff-banner-row {
    font-size: 11px;
    color: rgb(160, 175, 190);
    padding: 1px 0;
}

/* Quarantine Tab */
.quarantine-tab-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(40, 40, 40, 0.6);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
    min-height: 32px;
}

.quarantine-age-warning {
    font-size: 12px;
    color: rgb(240, 200, 80);
    background-color: rgba(150, 115, 25, 0.3);
    padding: 6px 8px;
    margin: 4px 8px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgba(220, 170, 40, 0.8);
}

/* Duplicate Asset Section (Overview Tab) */
.duplicate-section {
    flex-direction: column;
    padding: 8px 12px;
    background-color: rgba(30, 30, 30, 0.5);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
}

.duplicate-group {
    flex-direction: column;
    padding: 6px 8px;
    margin: 3px 0;
    background-color: rgba(45, 40, 50, 0.5);
    border-radius: 3px;
    border-left-width: 2px;
    border-left-color: rgba(160, 100, 180, 0.6);
}

.duplicate-group-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(175, 155, 195);
    margin-bottom: 3px;
}

.duplicate-item {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    margin: 1px 0;
    border-radius: 2px;
    font-size: 11px;
    color: rgb(155, 145, 165);
}

.duplicate-item:hover {
    background-color: rgba(70, 60, 80, 0.5);
    color: rgb(200, 190, 210);
}

/* Toast Notification System */
.toast-container {
    flex-direction: column-reverse;
    position: absolute;
    bottom: 28px;
    right: 8px;
    width: 320px;
}

.toast {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 4px;
    min-height: 28px;
}

.toast-success {
    background-color: rgba(50, 115, 50, 0.9);
}

.toast-warning {
    background-color: rgba(140, 115, 38, 0.9);
}

.toast-info {
    background-color: rgba(50, 90, 140, 0.9);
}

.toast-error {
    background-color: rgba(140, 50, 50, 0.9);
}

.toast-message {
    font-size: 11px;
    color: rgb(230, 230, 230);
    flex-grow: 1;
    white-space: normal;
}

/* Scan Log Panel */
.log-panel {
    margin: 8px;
    padding: 4px;
    border-width: 1px;
    border-color: rgba(60, 60, 60, 0.5);
    border-radius: 4px;
    background-color: rgba(30, 30, 30, 0.4);
}

.log-entry {
    font-size: 10px;
    padding: 2px 6px;
    margin-bottom: 1px;
    border-radius: 2px;
    color: rgb(160, 160, 160);
    white-space: normal;
}

.log-entry-warning {
    color: rgb(210, 180, 60);
    background-color: rgba(100, 80, 20, 0.2);
}

.log-entry-error {
    color: rgb(220, 90, 90);
    background-color: rgba(100, 30, 30, 0.2);
}

/* Asset Preview Image */
.asset-preview-image {
    align-self: center;
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.5);
}

/* Accessibility Settings Panel */
.accessibility-panel {
    flex-direction: column;
    padding: 8px 12px;
    background-color: rgba(30, 30, 30, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.accessibility-header {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 80, 0.4);
}

.accessibility-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
    margin-bottom: 2px;
}

.accessibility-label {
    font-size: 11px;
    color: rgb(170, 170, 170);
    min-width: 140px;
    margin-right: 8px;
}

.accessibility-dropdown {
    min-width: 160px;
    flex-shrink: 0;
}

.accessibility-slider {
    flex-grow: 1;
    min-width: 120px;
    max-width: 200px;
}

.accessibility-toggle {
    margin: 0 4px;
}

/* Read-Only Flag Column */
.readonly-flag {
    color: rgb(210, 140, 50);
    -unity-font-style: bold;
}

/* Safety Label Base Colours */
.safety-safe {
    color: rgb(115, 191, 115);
}

.safety-caution {
    color: rgb(217, 179, 64);
}

.safety-unsafe {
    color: rgb(217, 89, 89);
}

.safety-unknown {
    color: rgb(128, 128, 128);
}

/* Colour-Blind Mode: Deuteranopia */
.cb-deuteranopia .stat-value-warning {
    color: rgb(230, 159, 0);
}

.cb-deuteranopia .stat-value-danger {
    color: rgb(213, 94, 0);
}

.cb-deuteranopia .scan-button {
    background-color: rgba(0, 114, 178, 0.8);
    color: rgb(220, 235, 255);
}

.cb-deuteranopia .scan-button:hover {
    background-color: rgba(0, 114, 178, 1);
}

.cb-deuteranopia .quarantine-button {
    background-color: rgba(230, 159, 0, 0.7);
    color: rgb(40, 40, 40);
}

.cb-deuteranopia .quarantine-button:hover {
    background-color: rgba(230, 159, 0, 1);
}

.cb-deuteranopia .delete-button {
    background-color: rgba(204, 121, 167, 0.7);
    color: rgb(40, 40, 40);
}

.cb-deuteranopia .delete-button:hover {
    background-color: rgba(204, 121, 167, 1);
}

.cb-deuteranopia .restore-button {
    background-color: rgba(86, 180, 233, 0.7);
    color: rgb(20, 20, 20);
}

.cb-deuteranopia .restore-button:hover {
    background-color: rgba(86, 180, 233, 1);
}

.cb-deuteranopia .tab-button--active {
    border-bottom-color: rgb(0, 114, 178);
}

.cb-deuteranopia .category-bar-fill {
    background-color: rgba(0, 114, 178, 0.8);
}

.cb-deuteranopia .toast-success {
    background-color: rgba(0, 114, 178, 0.9);
}

.cb-deuteranopia .toast-warning {
    background-color: rgba(230, 159, 0, 0.9);
}

.cb-deuteranopia .toast-error {
    background-color: rgba(204, 121, 167, 0.9);
}

.cb-deuteranopia .progress-bar-fill {
    background-color: rgba(0, 114, 178, 0.9);
}

/* Deuteranopia safety label overrides - blue/orange/pink instead of green/yellow/red */
.cb-deuteranopia .safety-safe {
    color: rgb(86, 180, 233);
}

.cb-deuteranopia .safety-caution {
    color: rgb(230, 159, 0);
}

.cb-deuteranopia .safety-unsafe {
    color: rgb(204, 121, 167);
}

/* Colour-Blind Mode: Protanopia */

.cb-protanopia .stat-value-warning {
    color: rgb(240, 228, 66);
}

.cb-protanopia .stat-value-danger {
    color: rgb(213, 94, 0);
}

.cb-protanopia .scan-button {
    background-color: rgba(0, 114, 178, 0.8);
    color: rgb(220, 235, 255);
}

.cb-protanopia .scan-button:hover {
    background-color: rgba(0, 114, 178, 1);
}

.cb-protanopia .quarantine-button {
    background-color: rgba(240, 228, 66, 0.7);
    color: rgb(40, 40, 40);
}

.cb-protanopia .quarantine-button:hover {
    background-color: rgba(240, 228, 66, 1);
}

.cb-protanopia .delete-button {
    background-color: rgba(204, 121, 167, 0.7);
    color: rgb(40, 40, 40);
}

.cb-protanopia .delete-button:hover {
    background-color: rgba(204, 121, 167, 1);
}

.cb-protanopia .restore-button {
    background-color: rgba(86, 180, 233, 0.7);
    color: rgb(20, 20, 20);
}

.cb-protanopia .restore-button:hover {
    background-color: rgba(86, 180, 233, 1);
}

.cb-protanopia .tab-button--active {
    border-bottom-color: rgb(0, 114, 178);
}

.cb-protanopia .category-bar-fill {
    background-color: rgba(0, 114, 178, 0.8);
}

.cb-protanopia .toast-success {
    background-color: rgba(0, 114, 178, 0.9);
}

.cb-protanopia .toast-warning {
    background-color: rgba(240, 228, 66, 0.9);
}

.cb-protanopia .toast-error {
    background-color: rgba(204, 121, 167, 0.9);
}

.cb-protanopia .progress-bar-fill {
    background-color: rgba(0, 114, 178, 0.9);
}

/* Protanopia safety label overrides - blue/yellow/pink instead of green/yellow/red */
.cb-protanopia .safety-safe {
    color: rgb(86, 180, 233);
}

.cb-protanopia .safety-caution {
    color: rgb(240, 228, 66);
}

.cb-protanopia .safety-unsafe {
    color: rgb(204, 121, 167);
}

/* Colour-Blind Mode: Tritanopia */

.cb-tritanopia .stat-value-warning {
    color: rgb(230, 159, 0);
}

.cb-tritanopia .stat-value-danger {
    color: rgb(204, 121, 167);
}

.cb-tritanopia .scan-button {
    background-color: rgba(0, 158, 115, 0.8);
    color: rgb(220, 255, 240);
}

.cb-tritanopia .scan-button:hover {
    background-color: rgba(0, 158, 115, 1);
}

.cb-tritanopia .quarantine-button {
    background-color: rgba(230, 159, 0, 0.7);
    color: rgb(40, 40, 40);
}

.cb-tritanopia .quarantine-button:hover {
    background-color: rgba(230, 159, 0, 1);
}

.cb-tritanopia .delete-button {
    background-color: rgba(204, 121, 167, 0.7);
    color: rgb(40, 40, 40);
}

.cb-tritanopia .delete-button:hover {
    background-color: rgba(204, 121, 167, 1);
}

.cb-tritanopia .restore-button {
    background-color: rgba(0, 158, 115, 0.5);
    color: rgb(220, 255, 240);
}

.cb-tritanopia .restore-button:hover {
    background-color: rgba(0, 158, 115, 0.8);
}

.cb-tritanopia .tab-button--active {
    border-bottom-color: rgb(0, 158, 115);
}

.cb-tritanopia .category-bar-fill {
    background-color: rgba(0, 158, 115, 0.8);
}

.cb-tritanopia .toast-success {
    background-color: rgba(0, 158, 115, 0.9);
}

.cb-tritanopia .toast-warning {
    background-color: rgba(230, 159, 0, 0.9);
}

.cb-tritanopia .toast-error {
    background-color: rgba(204, 121, 167, 0.9);
}

.cb-tritanopia .progress-bar-fill {
    background-color: rgba(0, 158, 115, 0.9);
}

/* Tritanopia safety label overrides - green/orange/pink (blue-yellow affected, not red-green) */
.cb-tritanopia .safety-safe {
    color: rgb(0, 158, 115);
}

.cb-tritanopia .safety-caution {
    color: rgb(230, 159, 0);
}

.cb-tritanopia .safety-unsafe {
    color: rgb(204, 121, 167);
}

/* High Contrast Mode */

.high-contrast .toolbar {
    background-color: rgba(0, 0, 0, 0.9);
    border-bottom-color: rgb(255, 255, 255);
    border-bottom-width: 2px;
}

.high-contrast .toolbar-button {
    border-width: 1px;
    border-color: rgb(200, 200, 200);
}

.high-contrast .tab-bar {
    background-color: rgba(0, 0, 0, 0.9);
    border-bottom-color: rgb(255, 255, 255);
    border-bottom-width: 2px;
}

.high-contrast .tab-button {
    color: rgb(200, 200, 200);
    border-width: 1px;
    border-color: rgb(120, 120, 120);
}

.high-contrast .tab-button--active {
    color: rgb(255, 255, 255);
    background-color: rgba(80, 80, 80, 1);
    border-bottom-color: rgb(255, 255, 0);
    border-bottom-width: 3px;
}

.high-contrast .stat-card {
    border-width: 1px;
    border-color: rgb(150, 150, 150);
}

.high-contrast .filter-bar {
    border-bottom-color: rgb(200, 200, 200);
    border-bottom-width: 2px;
}

.high-contrast .status-bar {
    border-top-color: rgb(200, 200, 200);
    border-top-width: 2px;
}

/* Keyboard Focus Indicators */

.toolbar-button:focus {
    border-width: 2px;
    border-color: rgb(100, 180, 255);
}

.tab-button:focus {
    border-width: 2px;
    border-color: rgb(100, 180, 255);
}

.filter-dropdown:focus {
    border-width: 1px;
    border-color: rgb(100, 180, 255);
}

.search-field:focus {
    border-width: 1px;
    border-color: rgb(100, 180, 255);
}

.vcs-local    { color: rgb(100, 200, 120); }   /* green — your checkout */
.vcs-other    { color: rgb(220, 180,  60); }   /* amber — someone else */
.vcs-locked   { color: rgb(220,  80,  80); }   /* red — blocked */
.vcs-stale    { color: rgb(180, 140, 220); }   /* purple — out of date */
.vcs-unversioned { color: rgb(150, 150, 150); } /* grey — local only */